{
    "packageManager": "pnpm@11.13.1",
    "devDependencies": {
        "@enonic-types/core": "7.15.1",
        "@enonic-types/global": "7.15.1",
        "@enonic-types/guillotine": "^7.3.2",
        "@enonic-types/lib-cluster": "7.15.1",
        "@enonic-types/lib-content": "7.15.1",
        "@enonic-types/lib-context": "7.15.1",
        "@enonic-types/lib-event": "7.15.1",
        "@enonic-types/lib-export": "7.15.1",
        "@enonic-types/lib-node": "7.15.1",
        "@enonic-types/lib-portal": "7.15.1",
        "@enonic-types/lib-project": "7.15.1",
        "@enonic-types/lib-repo": "^7.15.1",
        "@enonic-types/lib-scheduler": "7.15.1",
        "@enonic-types/lib-task": "7.15.1",
        "@eslint/js": "^9.39.4",
        "@item-enonic-types/global": "7.15.0",
        "@item-enonic-types/lib-http-client": "3.2.2",
        "@item-enonic-types/lib-thymeleaf": "^2.1.0",
        "@item-enonic-types/lib-time": "^1.5.0",
        "@swc/core": "1.15.8",
        "browser-sync": "3.0.4",
        "concurrently": "9.2.4",
        "esbuild-plugin-globals": "^0.2.0",
        "esbuild-sass-plugin": "^3.7.0",
        "eslint": "^9.39.4",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "glob": "13.0.6",
        "prettier": "^3.8.1",
        "rimraf": "6.1.2",
        "sass": "^1.98.0",
        "tsup": "8.5.1",
        "typescript-eslint": "^8.57.1"
    },
    "directories": {
        "doc": "docs"
    },
    "scripts": {
        "clean": "rimraf build",
        "build": "concurrently -c auto -g --timings pnpm:build:*",
        "build:sass": "sass src/main/resources/assets/styles:build/resources/main/assets/styles",
        "build:server": "tsup -d build/resources/main",
        "build:static": "tsup -d build/resources/main/static",
        "check": "concurrently -c auto -g --timings pnpm:lint && echo 'pnpm:check:types is turned off. TODO: activate it again'",
        "check:types": "concurrently -g -r --timings pnpm:check:types:*",
        "check:types:server": "tsc --noEmit",
        "check:types:static": "tsc --noEmit -p src/main/resources/static/tsconfig.json",
        "lint": "eslint",
        "minify": "concurrently -c auto -g --timings 'pnpm:build:sass --style compressed' 'pnpm:build:server --minify' 'pnpm:build:static --minify'",
        "watch": "concurrently -c auto pnpm:watch:*",
        "watch:browserSync": "browser-sync start --files \"src/main/resources/**/*.html\" \"src/main/resources/**/*.xml\" \"build/resources/main\" --reload-delay 0 --port 3100 --no-snippet --watch",
        "watch:sass": "pnpm build:sass --watch",
        "watch:server": "pnpm build:server --watch",
        "watch:static": "pnpm build:static --watch",
        "test": "pnpm lint"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/navikt/idebanken.git"
    },
    "keywords": [
        "idébanken",
        "idebanken",
        "enonic",
        "xp",
        "cms"
    ],
    "author": "Idébanken",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/navikt/idebanken/issues"
    },
    "homepage": "https://idebanken.org",
    "engines": {
        "node": ">=24",
        "pnpm": ">=11"
    },
    "dependencies": {
        "@babel/generator": "^7.29.1",
        "@babel/parser": "^7.29.2",
        "@babel/traverse": "^7.29.0",
        "@babel/types": "^7.29.0"
    }
}
